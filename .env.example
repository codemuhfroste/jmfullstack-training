# Copy this file to .env.local for local development, and add the same
# variables in Vercel under Project → Settings → Environment Variables.
#
# With no TURSO_DATABASE_URL, `npm run dev` uses a local SQLite file
# (.data/local.db), so you can try accounts without a Turso database.

# From `turso db show <database> --url`
TURSO_DATABASE_URL=

# From `turso db tokens create <database>`
TURSO_AUTH_TOKEN=

# Optional. When set, signing up requires this code: share it with the people
# you want to let in. Leave empty to let anyone create an account.
SIGNUP_CODE=
